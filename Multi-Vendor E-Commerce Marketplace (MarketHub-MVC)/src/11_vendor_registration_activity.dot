digraph G {
layout=neato; splines=true; overlap=true;
labelloc=t; fontsize=22; fontname="DejaVu Sans"; label="Vendor Registration and Approval - Activity Diagram";
node [fontname="DejaVu Sans", fontsize=13, style="filled,rounded", shape=box, margin="0.12,0.08"];
edge [fontname="DejaVu Sans", fontsize=11, arrowsize=0.8];
s [label="Start", shape=ellipse, style=filled, fillcolor="#C8E6C9", width=1.3, height=0.6, pos="0.00,0.00!"];
a1 [label="Open Vendor\nApplication form", shape=box, style="filled,rounded", fillcolor="#FFF3CD", width=2.4, height=0.9, pos="3.30,0.00!"];
a2 [label="Fill account +\nstore details", shape=box, style="filled,rounded", fillcolor="#FFF3CD", width=2.4, height=0.9, pos="6.60,0.00!"];
d1 [label="Valid and\nunique?", shape=diamond, style=filled, fillcolor="#E3F2FD", width=2.5, height=1.25, fontsize=12, pos="9.90,0.00!"];
s2 [label="Create ApplicationUser\n(no Vendor role yet)", shape=box, style="filled,rounded", fillcolor="#E3F2FD", width=2.4, height=0.9, pos="13.20,0.00!"];
s3 [label="Create VendorProfile\nStatus = Pending", shape=box, style="filled,rounded", fillcolor="#E3F2FD", width=2.4, height=0.9, pos="13.20,-1.70!"];
s4 [label="Show: application\nunder review", shape=box, style="filled,rounded", fillcolor="#E3F2FD", width=2.4, height=0.9, pos="9.90,-1.70!"];
ad1 [label="Admin opens\nPending Applications", shape=box, style="filled,rounded", fillcolor="#E8F5E9", width=2.4, height=0.9, pos="6.60,-1.70!"];
ad2 [label="Approve or\nReject?", shape=diamond, style=filled, fillcolor="#E8F5E9", width=2.5, height=1.25, fontsize=12, pos="3.30,-1.70!"];
ap [label="Approve: add Vendor role,\nStatus = Approved,\nupdate SecurityStamp", shape=box, style="filled,rounded", fillcolor="#E3F2FD", width=2.4, height=0.9, pos="1.98,-3.91!"];
rj [label="Reject: Status = Rejected,\nsave RejectionReason,\nno Vendor role", shape=box, style="filled,rounded", fillcolor="#E3F2FD", width=2.4, height=0.9, pos="7.92,-3.91!"];
e [label="End", shape=ellipse, style=filled, fillcolor="#E0E0E0", width=1.3, height=0.6, pos="4.95,-5.78!"];
s->a1
a1->a2
a2->d1
d1->s2 [label="Yes"]
d1->a2 [label="No (show errors)", constraint=false]
s2->s3
s3->s4
s4->ad1
ad1->ad2
ad2->ap [label="Approve"]
ad2->rj [label="Reject"]
ap->e
rj->e
legend [shape=plaintext, style="", fontsize=12, label="Legend:  yellow = Applicant   blue = System   green = Super Admin", pos="1.50,-4.10!"];
}