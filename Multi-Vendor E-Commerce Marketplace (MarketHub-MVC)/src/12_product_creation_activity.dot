digraph G {
layout=neato; splines=true; overlap=true;
labelloc=t; fontsize=22; fontname="DejaVu Sans"; label="Product Creation - Activity Diagram";
node [fontname="DejaVu Sans", fontsize=13, style="filled,rounded", shape=box, margin="0.12,0.08"];
edge [fontname="DejaVu Sans", fontsize=11, arrowsize=0.8];
s [label="Vendor opens\nCreate Product", shape=ellipse, style=filled, fillcolor="#C8E6C9", width=1.3, height=0.6, pos="0.00,0.00!"];
d1 [label="Approved\nVendor?", shape=diamond, style=filled, fillcolor="#E3F2FD", width=2.5, height=1.25, fontsize=12, pos="3.30,0.00!"];
f [label="Fill ProductViewModel\nName, Description, Price,\nStock, Category, Images", shape=box, style="filled,rounded", fillcolor="#FFF3CD", width=2.4, height=0.9, pos="6.60,0.00!"];
p [label="POST\n/Vendor/Products/Create", shape=box, style="filled,rounded", fillcolor="#FFF3CD", width=2.4, height=0.9, pos="9.90,0.00!"];
d2 [label="Fields\nvalid?", shape=diamond, style=filled, fillcolor="#E3F2FD", width=2.5, height=1.25, fontsize=12, pos="13.20,0.00!"];
x [label="403 Forbidden or\nredirect to Login", shape=box, style="filled,rounded", fillcolor="#FDE0DC", width=2.4, height=0.9, pos="3.30,2.04!"];
d3 [label="Images valid?\next, size, type", shape=diamond, style=filled, fillcolor="#E3F2FD", width=2.5, height=1.25, fontsize=12, pos="13.20,-2.04!"];
sv [label="Service sets VendorProfileId\nfrom current user (never\nfrom the form), saves\nProduct + ProductImages", shape=box, style="filled,rounded", fillcolor="#E3F2FD", width=2.4, height=0.9, pos="9.90,-2.04!"];
e [label="Redirect to My Products\nwith success message", shape=ellipse, style=filled, fillcolor="#E0E0E0", width=1.3, height=0.6, pos="6.60,-2.04!"];
s->d1
d1->f [label="Yes"]
d1->x [label="No"]
f->p
p->d2
d2->d3 [label="Yes"]
d2->f [label="No", constraint=false]
d3->sv [label="Yes"]
d3->f [label="No", constraint=false]
sv->e
legend [shape=plaintext, style="", fontsize=12, label="Legend:  yellow = Vendor   blue = System   red = error path", pos="2.00,2.50!"];
}