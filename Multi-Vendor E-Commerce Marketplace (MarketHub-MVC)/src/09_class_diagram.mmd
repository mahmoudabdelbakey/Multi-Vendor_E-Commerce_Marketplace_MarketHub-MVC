classDiagram
  direction LR
  class ApplicationUser {
    +string Id
    +string FullName
    +bool IsActive
  }
  class VendorProfile {
    +int Id
    +string UserId
    +string StoreName
    +VendorStatus Status
  }
  class Category {
    +int Id
    +string Name
    +string Slug
    +bool IsActive
  }
  class Product {
    +int Id
    +int VendorProfileId
    +int CategoryId
    +string Name
    +decimal Price
    +int StockQuantity
    +bool IsActive
  }
  class ProductImage {
    +int Id
    +string ImagePath
    +bool IsPrimary
  }
  class CartItem {
    +int Id
    +string CustomerId
    +int ProductId
    +int Quantity
  }
  class Order {
    +int Id
    +string OrderNumber
    +OrderStatus Status
    +decimal TotalAmount
  }
  class OrderItem {
    +int Id
    +string ProductNameSnapshot
    +decimal UnitPrice
    +int Quantity
    +decimal LineTotal
    +FulfillmentStatus FulfillmentStatus
  }
  class Payment {
    +int Id
    +string StripeCheckoutSessionId
    +decimal Amount
    +PaymentStatus Status
  }
  class StripeWebhookEvent {
    +string StripeEventId
    +string EventType
  }
  class CommissionSetting {
    +decimal RatePercent
    +DateTime EffectiveFrom
  }
  class CommissionRecord {
    +decimal GrossAmount
    +decimal RatePercentSnapshot
    +decimal CommissionAmount
    +decimal VendorNetAmount
  }
  class Review {
    +int Rating
    +string Comment
  }
  class VendorStatus { <<enumeration>> Pending Approved Rejected Suspended }
  class OrderStatus { <<enumeration>> PendingPayment Paid Completed Cancelled }
  class PaymentStatus { <<enumeration>> Pending Succeeded Failed Expired }
  class FulfillmentStatus { <<enumeration>> Pending Shipped Delivered Cancelled }
  class ICheckoutService { <<interface>> +CreateOrderAndSessionAsync() }
  class IStripeWebhookService { <<interface>> +HandleAsync(json, signature) }
  class ICommissionService { <<interface>> +CreateForOrderAsync(orderId) }
  ApplicationUser "1" --> "0..1" VendorProfile
  ApplicationUser "1" --> "*" Order
  ApplicationUser "1" --> "*" CartItem
  ApplicationUser "1" --> "*" Review
  VendorProfile "1" --> "*" Product
  Category "1" --> "*" Product
  Product "1" --> "*" ProductImage
  Product "1" --> "*" CartItem
  Product "1" --> "*" OrderItem
  Product "1" --> "*" Review
  Order "1" *-- "1..*" OrderItem
  Order "1" --> "*" Payment
  VendorProfile "1" --> "*" OrderItem
  OrderItem "1" --> "0..1" CommissionRecord
  CommissionSetting "1" --> "*" CommissionRecord
  VendorProfile --> VendorStatus
  Order --> OrderStatus
  Payment --> PaymentStatus
  OrderItem --> FulfillmentStatus
  ICheckoutService ..> Order : creates
  IStripeWebhookService ..> StripeWebhookEvent : records
  IStripeWebhookService ..> ICommissionService : uses
