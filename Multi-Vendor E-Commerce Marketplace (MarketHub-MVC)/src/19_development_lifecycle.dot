digraph G {
layout=neato; splines=true; overlap=true;
labelloc=t; fontsize=22; fontname="DejaVu Sans"; label="Development Lifecycle (Sprint Loop)";
node [fontname="DejaVu Sans", fontsize=13, style="filled,rounded", shape=box, margin="0.12,0.08"];
edge [fontname="DejaVu Sans", fontsize=11, arrowsize=0.8];
a [label="Product Backlog\n(user stories)", shape=box, style="filled,rounded", fillcolor="#E8F5E9", width=2.4, height=0.9, pos="0.00,0.00!"];
b [label="Shared Sprint\nPlanning", shape=box, style="filled,rounded", fillcolor="#FFF3CD", width=2.4, height=0.9, pos="3.30,0.00!"];
c [label="Shared Design Session\nrequirements, ERD, UI", shape=box, style="filled,rounded", fillcolor="#FFF3CD", width=2.4, height=0.9, pos="6.60,0.00!"];
d [label="Implement vertical slice\nDB, Service, Controller, View", shape=box, style="filled,rounded", fillcolor="#E3F2FD", width=2.4, height=0.9, pos="9.90,0.00!"];
e [label="Collective Testing\nunit, integration, manual", shape=box, style="filled,rounded", fillcolor="#E3F2FD", width=2.4, height=0.9, pos="13.20,0.00!"];
f [label="Cross-member\nCode Review", shape=box, style="filled,rounded", fillcolor="#FFF3CD", width=2.4, height=0.9, pos="13.20,-2.72!"];
g [label="Integration into main\n+ regression run", shape=box, style="filled,rounded", fillcolor="#E3F2FD", width=2.4, height=0.9, pos="9.90,-2.72!"];
h [label="Sprint Review\n(demo)", shape=box, style="filled,rounded", fillcolor="#E8F5E9", width=2.4, height=0.9, pos="6.60,-2.72!"];
i [label="Retrospective", shape=box, style="filled,rounded", fillcolor="#E8F5E9", width=2.4, height=0.9, pos="3.30,-2.72!"];
j [label="Deploy to demo\nenvironment (Sprint 9)", shape=ellipse, style=filled, fillcolor="#E0E0E0", width=1.3, height=0.6, pos="9.90,-5.10!"];
a->b
b->c
c->d
d->e
e->f
f->g
g->h
h->i
i->a [label="next Sprint"]
g->j [style=dashed]
}