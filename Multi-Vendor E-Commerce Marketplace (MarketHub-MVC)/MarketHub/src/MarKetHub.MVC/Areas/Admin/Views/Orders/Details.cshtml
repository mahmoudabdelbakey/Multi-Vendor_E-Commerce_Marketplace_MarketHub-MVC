@using MarketHub.BLL.Models
@model OrderDetailsDto
@{
    ViewData["Title"] = "Order Details";
}

<div class="container mt-4">
    <h2>Order @Model.OrderNumber</h2>

    <div class="row">
        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-header">Order Info</div>
                <div class="card-body">
                    <p><strong>Status:</strong> @Model.Status</p>
                    <p><strong>Total:</strong> @Model.TotalAmount.ToString("C") @Model.Currency</p>
                    <p><strong>Created:</strong> @Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</p>
                    @if (Model.PaidAt.HasValue)
                    {
                        <p><strong>Paid:</strong> @Model.PaidAt.Value.ToString("yyyy-MM-dd HH:mm")</p>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-header">Customer</div>
                <div class="card-body">
                    <p><strong>Name:</strong> @Model.CustomerName</p>
                    <p><strong>Email:</strong> @Model.CustomerEmail</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">Shipping</div>
        <div class="card-body">
            <p>@Model.Shipping.FullName</p>
            <p>@Model.Shipping.Phone</p>
            <p>@Model.Shipping.Address</p>
            <p>@Model.Shipping.City, @Model.Shipping.Country</p>
        </div>
    </div>

    <div class="card">
        <div class="card-header">Items</div>
        <div class="card-body">
            <table class="table">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Vendor</th>
                        <th>Price</th>
                        <th>Qty</th>
                        <th>Total</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.ProductName</td>
                            <td>@item.StoreName</td>
                            <td>@item.UnitPrice.ToString("C")</td>
                            <td>@item.Quantity</td>
                            <td>@item.LineTotal.ToString("C")</td>
                            <td>@item.FulfillmentStatus</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary">Back to Orders</a>
    </div>
</div>
