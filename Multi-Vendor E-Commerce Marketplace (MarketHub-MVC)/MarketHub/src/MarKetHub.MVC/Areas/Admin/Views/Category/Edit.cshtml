@using MarketHub.BLL.Models
@model CategoryDto
@{
    ViewData["Title"] = "Edit Category";
}

<div class="container mt-4">
    <h2>Edit Category</h2>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <form asp-action="Edit" method="post">
        <input type="hidden" name="id" value="@Model.Id" />

        <div class="mb-3">
            <label class="form-label">Name</label>
            <input type="text" name="name" class="form-control" value="@Model.Name" required maxlength="80" />
        </div>

        <div class="mb-3 form-check">
            <input type="checkbox" name="isActive" value="true" class="form-check-input" @(Model.IsActive ? "checked" : "") />
            <label class="form-check-label">Active</label>
        </div>

        @if (Model.ProductCount > 0)
        {
            <div class="alert alert-info">
                This category has @Model.ProductCount active product(s). You cannot hide it while products are active.
            </div>
        }

        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
