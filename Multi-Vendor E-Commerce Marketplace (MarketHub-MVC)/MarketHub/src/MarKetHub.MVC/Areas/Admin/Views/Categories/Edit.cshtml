@model MarketHub.MVC.ViewModels.CategoryFormViewModel
@{
    ViewData["Title"] = "Edit category";
}

<div class="container mt-4" style="max-width: 560px;">
    <h2>Edit category</h2>

    <form asp-area="Admin" asp-controller="Categories" asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card card-body">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label class="form-label" asp-for="Name"></label>
            <input class="form-control" asp-for="Name" maxlength="80" />
            <span class="text-danger" asp-validation-for="Name"></span>
        </div>

        <div class="form-check mb-3">
            <input class="form-check-input" asp-for="IsActive" />
            <label class="form-check-label" asp-for="IsActive">Visible in the shop</label>
        </div>

        @if (Model.WasActive && Model.ActiveProductCount > 0)
        {
            <div class="alert alert-warning">
                This category has <strong>@Model.ActiveProductCount</strong> active product(s).
                To hide it, untick "Visible in the shop" and confirm below.
                <div class="form-check mt-2">
                    <input class="form-check-input" asp-for="ConfirmHide" />
                    <label class="form-check-label" asp-for="ConfirmHide">I understand, hide this category</label>
                </div>
                <span class="text-danger" asp-validation-for="ConfirmHide"></span>
            </div>
        }

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Save</button>
            <a class="btn btn-outline-secondary" asp-area="Admin" asp-controller="Categories" asp-action="Index">Back</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
