@model MarketHub.MVC.ViewModels.CategoryFormViewModel
@{
    ViewData["Title"] = "Add category";
}

<div class="container mt-4" style="max-width: 560px;">
    <h2>Add category</h2>

    <form asp-area="Admin" asp-controller="Categories" asp-action="Create" method="post" class="card card-body">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label class="form-label" asp-for="Name"></label>
            <input class="form-control" asp-for="Name" maxlength="80" autofocus />
            <span class="text-danger" asp-validation-for="Name"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Create</button>
            <a class="btn btn-outline-secondary" asp-area="Admin" asp-controller="Categories" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
