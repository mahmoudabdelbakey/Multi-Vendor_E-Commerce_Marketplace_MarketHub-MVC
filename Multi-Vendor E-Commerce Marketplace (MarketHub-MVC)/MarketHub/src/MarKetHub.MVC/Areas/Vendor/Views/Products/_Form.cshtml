@model ProductFormViewModel
@* The <form> element itself is in Create.cshtml / Edit.cshtml (they post to different actions). *@

<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

<div class="mb-3">
    <label class="form-label" asp-for="Name"></label>
    <input class="form-control" asp-for="Name" maxlength="150" autocomplete="off" />
    <span class="text-danger" asp-validation-for="Name"></span>
</div>

<div class="mb-3">
    <label class="form-label" asp-for="Description"></label>
    <textarea class="form-control" asp-for="Description" rows="4" maxlength="2000"></textarea>
    <span class="text-danger" asp-validation-for="Description"></span>
</div>

<div class="row">
    <div class="col-md-4 mb-3">
        <label class="form-label" asp-for="Price"></label>
        <input class="form-control" asp-for="Price" type="number" step="0.01" min="0.01" max="1000000" inputmode="decimal" />
        <span class="text-danger" asp-validation-for="Price"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label class="form-label" asp-for="StockQuantity"></label>
        <input class="form-control" asp-for="StockQuantity" type="number" step="1" min="0" max="1000000" inputmode="numeric" />
        <span class="text-danger" asp-validation-for="StockQuantity"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label class="form-label" asp-for="CategoryId"></label>
        <select class="form-select" asp-for="CategoryId" asp-items="Model.Categories">
            <option value="">Choose a category...</option>
        </select>
        <span class="text-danger" asp-validation-for="CategoryId"></span>
    </div>
</div>

<div class="form-check mb-3">
    <input class="form-check-input" asp-for="IsActive" />
    <label class="form-check-label" asp-for="IsActive"></label>
    <div class="form-text">Hidden products stay in your list but customers can not see or buy them.</div>
</div>

@if (Model.ExistingImages.Count > 0)
{
    <div class="mb-3">
        <div class="form-label">Current images</div>
        <div class="d-flex flex-wrap gap-2">
            @foreach (var image in Model.ExistingImages)
            {
                <div class="position-relative">
                    <img src="@ImageUrl(image.Path)" alt="Product image" class="rounded border" style="width: 6rem; height: 6rem; object-fit: cover;" />
                    @if (image.IsPrimary)
                    {
                        <span class="badge text-bg-primary position-absolute bottom-0 start-0 m-1">Main</span>
                    }
                </div>
            }
        </div>
    </div>
}

<div class="mb-3">
    <label class="form-label" asp-for="NewImages"></label>
    <input class="form-control" asp-for="NewImages" type="file" multiple accept="image/jpeg,image/png,image/webp" />
    <div class="form-text">JPG, PNG or WEBP, up to 2 MB each, at most 8 images per product. The first image is the main image.</div>
    <span class="text-danger" asp-validation-for="NewImages"></span>
</div>
