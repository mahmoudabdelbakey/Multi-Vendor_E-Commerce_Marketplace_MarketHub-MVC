@model ProductFormViewModel
@{
    ViewData["Title"] = "Add product";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <h1 class="h3 mb-3">Add product</h1>

        <form asp-area="Vendor" asp-controller="Products" asp-action="Create" method="post" enctype="multipart/form-data"
              class="card card-body" data-once>
            <partial name="_Form" model="Model" />

            <div class="d-flex gap-2">
                <button class="btn btn-primary" type="submit">Create product</button>
                <a class="btn btn-outline-secondary" asp-area="Vendor" asp-controller="Products" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
