@model ProductListViewModel
@{
    ViewData["Title"] = "My products";
    var products = Model.Products;
    var searching = !string.IsNullOrEmpty(Model.Search);
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="h3 mb-0">My products</h1>
    <a class="btn btn-primary" asp-area="Vendor" asp-controller="Products" asp-action="Create">Add product</a>
</div>

@* TASK-37: search by name. GET, so the address can be bookmarked and the paging links keep the text. *@
@if (products.TotalCount > 0 || searching)
{
    <form asp-area="Vendor" asp-controller="Products" asp-action="Index" method="get" class="d-flex flex-wrap gap-2 mb-3" role="search">
        <input type="search" name="q" value="@Model.Search" class="form-control" style="max-width: 22rem;"
               maxlength="100" placeholder="Search my products by name" aria-label="Search my products by name" />
        <button type="submit" class="btn btn-outline-primary">Search</button>
        @if (searching)
        {
            <a class="btn btn-outline-secondary" asp-area="Vendor" asp-controller="Products" asp-action="Index">Clear</a>
        }
    </form>
}

@if (products.TotalCount == 0 && searching)
{
    <div class="card card-body text-center py-5">
        <p class="lead mb-2">No product matches "@Model.Search".</p>
        <div><a class="btn btn-outline-primary" asp-area="Vendor" asp-controller="Products" asp-action="Index">Show all my products</a></div>
    </div>
}
else if (products.TotalCount == 0)
{
    <div class="card card-body text-center py-5">
        <p class="lead mb-2">You have no products yet.</p>
        <p class="text-muted mb-3">Add your first product and it will appear in the store.</p>
        <div><a class="btn btn-primary" asp-area="Vendor" asp-controller="Products" asp-action="Create">Add your first product</a></div>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col" style="width: 5rem;"></th>
                        <th scope="col">Product</th>
                        <th scope="col">Category</th>
                        <th scope="col" class="text-end">Price</th>
                        <th scope="col" class="text-end">Stock</th>
                        <th scope="col">Status</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var p in products.Items)
                {
                    <tr>
                        <td>
                            <img src="@ImageUrl(p.ImagePath)" alt="" class="product-thumb rounded" style="width: 4rem; height: 3rem;" />
                        </td>
                        <td class="fw-semibold">@p.Name</td>
                        <td>@p.CategoryName</td>
                        <td class="text-end">@Money(p.Price)</td>
                        <td class="text-end">
                            @* Quick stock change (TASK-37). *@
                            <form asp-area="Vendor" asp-controller="Products" asp-action="UpdateStock" asp-route-id="@p.Id" method="post"
                                  class="d-inline-flex gap-1 justify-content-end" data-once>
                                <input type="hidden" name="q" value="@Model.Search" />
                                <input type="hidden" name="page" value="@products.Page" />
                                <input type="number" name="quantity" value="@p.StockQuantity" min="0" max="1000000" step="1"
                                       class="form-control form-control-sm text-end" style="width: 6rem;"
                                       aria-label="Stock of @p.Name" required />
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Set</button>
                            </form>
                            @if (p.StockQuantity == 0)
                            {
                                <div><span class="badge text-bg-danger">Out of stock</span></div>
                            }
                            else if (p.StockQuantity <= 5)
                            {
                                <div><span class="badge text-bg-warning">Low stock</span></div>
                            }
                        </td>
                        <td>
                            @if (p.IsActive)
                            {
                                <span class="badge text-bg-success">Visible</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Hidden</span>
                            }
                        </td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-area="Vendor" asp-controller="Products" asp-action="Edit" asp-route-id="@p.Id">Edit</a>

                            @* Show / hide (TASK-37): the button asks for the NEW value. *@
                            <form asp-area="Vendor" asp-controller="Products" asp-action="ToggleActive" asp-route-id="@p.Id" method="post" class="d-inline" data-once>
                                <input type="hidden" name="isActive" value="@((!p.IsActive).ToString().ToLowerInvariant())" />
                                <input type="hidden" name="q" value="@Model.Search" />
                                <input type="hidden" name="page" value="@products.Page" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary">@(p.IsActive ? "Hide" : "Show")</button>
                            </form>

                            <form asp-area="Vendor" asp-controller="Products" asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline"
                                  data-confirm="Delete &quot;@p.Name&quot;? A product that already has orders is hidden instead of deleted.">
                                <input type="hidden" name="q" value="@Model.Search" />
                                <input type="hidden" name="page" value="@products.Page" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3">
        <span class="text-muted small">
            @products.TotalCount @(products.TotalCount == 1 ? "product" : "products")@(searching ? " found" : "") - page @products.Page of @Math.Max(1, products.TotalPages)
        </span>
        @if (products.TotalPages > 1)
        {
            <nav aria-label="Products pages">
                <ul class="pagination mb-0">
                    <li class="page-item @(products.HasPrevious ? "" : "disabled")">
                        <a class="page-link" asp-area="Vendor" asp-controller="Products" asp-action="Index"
                           asp-route-q="@Model.Search" asp-route-page="@(products.Page - 1)">Previous</a>
                    </li>
                    <li class="page-item @(products.HasNext ? "" : "disabled")">
                        <a class="page-link" asp-area="Vendor" asp-controller="Products" asp-action="Index"
                           asp-route-q="@Model.Search" asp-route-page="@(products.Page + 1)">Next</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
}
