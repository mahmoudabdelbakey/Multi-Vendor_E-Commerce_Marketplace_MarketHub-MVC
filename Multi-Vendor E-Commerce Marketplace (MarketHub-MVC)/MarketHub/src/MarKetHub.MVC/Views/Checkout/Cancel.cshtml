@model OrderDetailsDto
@{
    ViewData["Title"] = "Payment not completed";
}

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
            <div>
                <h1 class="h3 mb-1">Payment was not completed</h1>
                <p class="text-muted mb-0">Order <strong>@Model.OrderNumber</strong> &middot; @DateText(Model.CreatedAt)</p>
            </div>
            <span class="badge @OrderBadge(Model.Status) fs-6">@Model.Status</span>
        </div>

        @if (Model.Status == OrderStatus.PendingPayment)
        {
            <div class="alert alert-warning mb-0" role="alert">
                Your order is still <strong>PendingPayment</strong>. You can review or cancel it from your order details page, or wait for automatic expiration if abandoned.
            </div>
        }
        else if (Model.Status == OrderStatus.Cancelled)
        {
            <div class="alert alert-secondary mb-0" role="alert">
                This order has been cancelled and any reserved stock has been released.
            </div>
        }
        else
        {
            <div class="alert alert-success mb-0" role="alert">
                Payment for this order was already confirmed (@Model.Status).
            </div>
        }
    </div>
</div>

<div class="d-flex flex-wrap gap-2">
    <a class="btn btn-primary" asp-controller="Orders" asp-action="Details" asp-route-id="@Model.Id">View order details</a>
    <a class="btn btn-outline-secondary" asp-controller="Orders" asp-action="Index">My orders</a>
    <a class="btn btn-outline-secondary" asp-controller="Cart" asp-action="Index">Return to cart</a>
</div>
