@model MarketHub.MVC.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "Home";
}

<div class="container py-5">

    <!-- Welcome Section -->
    <section class="text-center py-5 mb-5 rounded-4 text-white hero">
        <h1 class="display-5 fw-bold mb-3">Welcome to MarketHub</h1>

        <p class="lead mb-4">
            Discover products from different stores, all in one place.
        </p>

        <a asp-controller="Catalog"
           asp-action="Index"
           class="btn btn-light btn-lg px-4">
            Explore Products
        </a>
    </section>

    <!-- Categories Section -->
    <section class="mb-5">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
            <div>
                <h2 class="fw-bold mb-1">Shop by Category</h2>
                <p class="text-secondary mb-0">
                    Explore our product categories
                </p>
            </div>

            <a asp-controller="Catalog"
               asp-action="Index"
               class="text-decoration-none">
                View All Products &rarr;
            </a>
        </div>

        @if (Model.Categories != null && Model.Categories.Any())
        {
            <div class="row g-3">
                @foreach (var category in Model.Categories)
                {
                    <div class="col-6 col-md-4 col-lg-3">
                        <a asp-controller="Catalog"
                           asp-action="Index"
                           asp-route-CategoryId="@category.Id"
                           class="text-decoration-none text-dark">

                            <div class="card h-100 border-0 shadow-sm rounded-4 text-center p-4">
                                <h5 class="fw-bold mb-2">
                                    @category.Name
                                </h5>

                                <p class="text-secondary mb-0 small">
                                    @category.ProductCount product(s)
                                </p>
                            </div>
                        </a>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-light text-center">
                No categories available at the moment.
            </div>
        }
    </section>

    <!-- Latest Products Section -->
    <section class="mb-5">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
            <div>
                <h2 class="fw-bold mb-1">Latest Products</h2>
                <p class="text-secondary mb-0">
                    Discover the latest products added to MarketHub
                </p>
            </div>

            <a asp-controller="Catalog"
               asp-action="Index"
               class="text-decoration-none">
                View All Products &rarr;
            </a>
        </div>

        @if (Model.LatestProducts != null && Model.LatestProducts.Any())
        {
            <div class="row g-4">
                @foreach (var product in Model.LatestProducts)
                {
                    <div class="col-12 col-sm-6 col-lg-3">
                        <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden product-card">

                            @if (!string.IsNullOrWhiteSpace(product.ImagePath))
                            {
                                <img src="@product.ImagePath"
                                     alt="@product.Name"
                                     class="product-thumb w-100" />
                            }
                            else
                            {
                                <div class="product-thumb d-flex align-items-center justify-content-center">
                                    <span class="text-secondary">
                                        No image available
                                    </span>
                                </div>
                            }

                            <div class="card-body d-flex flex-column">
                                <small class="text-secondary mb-2">
                                    @product.CategoryName
                                </small>

                                <h5 class="fw-bold mb-2">
                                    @product.Name
                                </h5>

                                <p class="text-secondary small mb-2">
                                    Sold by @product.StoreName
                                </p>

                                <h5 class="text-primary fw-bold mb-3">
                                    $@product.Price.ToString("N2")
                                </h5>

                                @if (product.StockQuantity > 0)
                                {
                                    <small class="text-success mb-3">
                                        In Stock
                                    </small>
                                }
                                else
                                {
                                    <small class="text-danger mb-3">
                                        Out of Stock
                                    </small>
                                }

                                <a asp-controller="Catalog"
                                   asp-action="Details"
                                   asp-route-id="@product.Id"
                                   class="btn btn-outline-primary mt-auto">
                                    View Details
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-light text-center">
                No products available at the moment.
            </div>
        }
    </section>

</div>