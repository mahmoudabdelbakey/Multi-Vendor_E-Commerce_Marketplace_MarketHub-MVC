@model MarketHub.BLL.Common.PagedResult<MarketHub.BLL.Models.ProductListItemDto>

@if (Model.TotalPages > 1)
{
    <nav aria-label="Product pagination">
        <ul class="pagination justify-content-center">

            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-controller="Catalog"
                   asp-action="Index"
                   asp-route-Page="@(Model.Page - 1)">
                    Previous
                </a>
            </li>

            @for (int page = 1; page <= Model.TotalPages; page++)
            {
                <li class="page-item @(page == Model.Page ? "active" : "")">
                    <a class="page-link"
                       asp-controller="Catalog"
                       asp-action="Index"
                       asp-route-Page="@(page)">
                        @(page)
                    </a>
                </li>
            }

            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link"
                   asp-controller="Catalog"
                   asp-action="Index"
                   asp-route-Page="@(Model.Page + 1)">
                    Next
                </a>
            </li>

        </ul>
    </nav>
}