@model ErrorViewModel
@{
    var statusCode = Model.StatusCode ?? 500;
    ViewData["Title"] = $"{statusCode} - {Model.Title}";

    var (badgeClass, iconBgClass, iconColorClass) = statusCode switch
    {
        404 => ("bg-primary-subtle text-primary", "bg-primary-subtle", "text-primary"),
        403 => ("bg-warning-subtle text-warning-emphasis", "bg-warning-subtle", "text-warning-emphasis"),
        >= 500 => ("bg-danger-subtle text-danger", "bg-danger-subtle", "text-danger"),
        _ => ("bg-secondary-subtle text-secondary", "bg-secondary-subtle", "text-secondary")
    };
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 text-center p-4 p-md-5 error-page-card">
                <div class="mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle error-icon-circle @iconBgClass @iconColorClass">
                    @if (statusCode == 404)
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                            <circle cx="11" cy="11" r="7" />
                            <path stroke-linecap="round" d="M20 20l-3.5-3.5" />
                            <path stroke-linecap="round" d="M8.5 11h5" />
                        </svg>
                    }
                    else if (statusCode == 403)
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                            <rect x="5" y="11" width="14" height="10" rx="2" />
                            <path stroke-linecap="round" d="M8 11V7a4 4 0 1 1 8 0v4" />
                        </svg>
                    }
                    else
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v4m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
                        </svg>
                    }
                </div>

                <div class="mb-2">
                    <span class="badge rounded-pill px-3 py-2 fw-semibold @badgeClass">
                        Error @statusCode
                    </span>
                </div>

                <h1 class="display-4 fw-bold text-dark mb-2">@statusCode</h1>
                <h2 class="h4 fw-semibold text-dark mb-3">@Model.Title</h2>
                <p class="text-muted mb-4">@Model.Message</p>

                @if (!string.IsNullOrEmpty(Model.RequestId))
                {
                    <div class="bg-light rounded-3 px-3 py-2 mb-4 small text-muted">
                        Request ID: <code class="text-dark">@Model.RequestId</code>
                    </div>
                }

                <div class="d-flex flex-wrap justify-content-center gap-2">
                    <a class="btn btn-primary px-4" asp-area="" asp-controller="Home" asp-action="Index">
                        Back to Home
                    </a>
                    <a class="btn btn-outline-secondary px-4" href="/Products">
                        Browse Products
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>