@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
}
<div class="text-center py-5">
    @if (Model.StatusCode is not null)
    {
        <div class="display-1 text-muted">@Model.StatusCode</div>
    }
    <h1 class="h3">@Model.Title</h1>
    <p class="text-muted">@Model.Message</p>
    @if (!string.IsNullOrEmpty(Model.RequestId))
    {
        <p class="small text-muted">Request ID: <code>@Model.RequestId</code></p>
    }
    <a class="btn btn-primary" asp-area="" asp-controller="Home" asp-action="Index">Back to the store</a>
</div>
