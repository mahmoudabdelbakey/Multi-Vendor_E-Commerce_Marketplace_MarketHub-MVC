@model MarketHub.BLL.Models.ProductListItemDto


<div class="card h-100 product-card shadow-sm border-0 rounded-4 overflow-hidden">

    <div class="product-thumb bg-light d-flex align-items-center justify-content-center">
        @if (string.IsNullOrWhiteSpace(Model.ImagePath))
        {
            <div class="text-secondary text-center">
                <div class="fs-1">&#128247;</div>
                <span>No image available</span>
            </div>
        }
        else
        {
            <img src="@Url.Content("~/" + Model.ImagePath.TrimStart('/'))"
                 alt="@Model.Name"
                 class="w-100 h-100"
                 style="object-fit: cover;" />
        }
    </div>

    <div class="card-body d-flex flex-column">

        <small class="text-secondary mb-2">@Model.CategoryName</small>

        <h5 class="card-title fw-bold">
            @Model.Name
        </h5>

        <p class="text-secondary small mb-2">
            Sold by @Model.StoreName
        </p>

        <h5 class="text-primary fw-bold mb-3">
            $@Model.Price.ToString("N2")
        </h5>

        @if (Model.StockQuantity > 0)
        {
            <span class="text-success small mb-3">
                In Stock
            </span>
        }
        else
        {
            <span class="text-danger small mb-3">
                Out of Stock
            </span>
        }

        <a asp-controller="Catalog"
           asp-action="Details"
           asp-route-id="@Model.Id"
           class="btn btn-outline-primary mt-auto">
            View Details
        </a>

    </div>
</div>