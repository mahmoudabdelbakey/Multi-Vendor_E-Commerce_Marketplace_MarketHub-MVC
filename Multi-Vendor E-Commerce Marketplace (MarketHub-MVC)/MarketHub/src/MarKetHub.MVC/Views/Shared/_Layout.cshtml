<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - MarketHub</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="d-flex flex-column min-vh-100">
<header>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">MarketHub</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Products" asp-action="Index">Products</a></li>

                    @if (User.IsInRole(Roles.Customer))
                    {
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Orders" asp-action="Index">My orders</a></li>
                        @* Week 2 (Member A, TASK-28): "Sell on MarketHub" link to Account/VendorStatus goes here. *@
                    }

                    @if (User.IsInRole(Roles.Vendor))
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Vendor</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-area="Vendor" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                                <li><a class="dropdown-item" asp-area="Vendor" asp-controller="Products" asp-action="Index">My products</a></li>
                                <li><a class="dropdown-item" asp-area="Vendor" asp-controller="Orders" asp-action="Index">Orders to ship</a></li>
                                <li><a class="dropdown-item" asp-area="Vendor" asp-controller="Store" asp-action="Edit">Store profile</a></li>
                            </ul>
                        </li>
                    }

                    @if (User.IsInRole(Roles.SuperAdmin))
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Admin</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                                <li><a class="dropdown-item" asp-area="Admin" asp-controller="VendorApplications" asp-action="Index">Vendors</a></li>
                                <li><a class="dropdown-item" asp-area="Admin" asp-controller="Categories" asp-action="Index">Categories</a></li>
                                <li><a class="dropdown-item" asp-area="Admin" asp-controller="Commission" asp-action="Index">Commission</a></li>
                                <li><a class="dropdown-item" asp-area="Admin" asp-controller="Orders" asp-action="Index">All orders</a></li>
                                <li><a class="dropdown-item" asp-area="Admin" asp-controller="Products" asp-action="Index">Moderate products</a></li>
                            </ul>
                        </li>
                    }
                </ul>

                <ul class="navbar-nav align-items-lg-center">
                    @if (User.IsInRole(Roles.Customer))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Cart" asp-action="Index">Cart @* Member D (TASK-21): put @await Component.InvokeAsync("CartCount") here once the View Component exists *@</a>
                        </li>
                    }

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item"><span class="navbar-text me-lg-2">@User.Identity.Name</span></li>
                        <li class="nav-item">
                            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-outline-light btn-sm">Log out</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Account" asp-action="Login">Log in</a></li>
                        <li class="nav-item"><a class="btn btn-primary btn-sm" asp-area="" asp-controller="Account" asp-action="Register">Sign up</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>

<main class="container py-4 flex-grow-1">
    @if (TempData["Success"] is string ok)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @ok
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] is string err)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @err
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @RenderBody()
</main>

<footer class="border-top py-3 text-muted small">
    <div class="container d-flex justify-content-between flex-wrap gap-2">
        <span>&copy; @DateTime.UtcNow.Year MarketHub - multi-vendor marketplace demo</span>
        <span>Payments run in Stripe <strong>test mode</strong>. Use card 4242 4242 4242 4242.</span>
    </div>
</footer>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
