@model RegisterViewModel
@{
    ViewData["Title"] = "Sign up";
}
<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <h1 class="h3 mb-3">Create your account</h1>
        <form asp-action="Register" method="post" class="card card-body">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label class="form-label" asp-for="FullName"></label>
                <input class="form-control" asp-for="FullName" autocomplete="name" />
                <span class="text-danger" asp-validation-for="FullName"></span>
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="Email"></label>
                <input class="form-control" asp-for="Email" autocomplete="username" />
                <span class="text-danger" asp-validation-for="Email"></span>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label" asp-for="Password"></label>
                    <input class="form-control" asp-for="Password" autocomplete="new-password" />
                    <span class="text-danger" asp-validation-for="Password"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label" asp-for="ConfirmPassword"></label>
                    <input class="form-control" asp-for="ConfirmPassword" autocomplete="new-password" />
                    <span class="text-danger" asp-validation-for="ConfirmPassword"></span>
                </div>
            </div>
            <div class="form-text mb-3">At least 8 characters, with an upper case letter, a lower case letter and a digit.</div>

            @* Week 2 (Member A, TASK-28): "I also want to sell on MarketHub" checkbox and the store fields go here. *@

            <button class="btn btn-primary" type="submit">Sign up</button>
        </form>
        <p class="mt-3 text-muted">Already registered? <a asp-action="Login">Log in</a></p>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
