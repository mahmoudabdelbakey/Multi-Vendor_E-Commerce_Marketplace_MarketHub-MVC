@model IReadOnlyList<MarketHub.DAL.Models.Category>

@{
    ViewData["Title"] = "Categories";
}

<div class="container py-4">
    <div class="mb-4">
        <h1 class="h2">Shop by Category</h1>
        <p class="text-muted">Explore products by category.</p>
    </div>

    
    @if (Model.Count == 0)
    {
        <div class="alert alert-info" role="status">
            No categories are available right now. Please check back later.
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-3">
            @foreach (var category in Model)
            {
                <div class="col">
                    <a class="card h-100 text-decoration-none text-reset shadow-sm"
                       asp-controller="Products"
                       asp-action="Index"
                       asp-route-category="@category.Slug">
                        <div class="card-body">
                            <h2 class="h5 card-title mb-2">@category.Name</h2>
                            <span class="text-primary">Browse products <span aria-hidden="true">→</span></span>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
    

</div>

