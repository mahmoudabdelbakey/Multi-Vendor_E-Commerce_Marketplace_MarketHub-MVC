@model MarketHub.MVC.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "Home";
    @section Styles {
        <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    }
}

<div class="container py-5">

    <!-- Hero Section -->
    <section class="home-hero rounded-4 p-4 p-md-5 mb-5">
        <div class="row align-items-center g-4">

            <div class="col-lg-7">

                <span class="badge text-bg-light mb-3">
                    Welcome to MarketHub
                </span>

                <h1 class="display-4 fw-bold mb-3">
                    @Model.Title
                </h1>

                <p class="lead mb-4">
                    @Model.Subtitle
                </p>

                <div class="d-flex flex-wrap gap-2">

                    <a asp-controller="Products"
                       asp-action="Index"
                       class="btn btn-light btn-lg">
                        Explore Products
                    </a>

                    <a href="#categories"
                       class="btn btn-outline-light btn-lg">
                        Browse Categories
                    </a>

                </div>

            </div>

            <div class="col-lg-5">
                <div class="home-hero-card p-4 rounded-4">

                    <h2 class="h4 fw-bold mb-3">
                        One Marketplace
                    </h2>

                    <p class="mb-0">
                        Discover products from different stores
                        and explore what the marketplace has to offer.
                    </p>

                </div>
            </div>

        </div>
    </section>


    <!-- Benefits Section -->
    <section class="mb-5">

        <div class="text-center mb-4">
            <h2 class="fw-bold">Why MarketHub?</h2>

            <p class="text-muted">
                A simple way to discover products from multiple stores.
            </p>
        </div>

        <div class="row g-3">

            <div class="col-md-4">
                <div class="benefit-card h-100 p-4 rounded-4">
                    <h3 class="h5 fw-bold">Multiple Stores</h3>

                    <p class="text-muted mb-0">
                        Explore products offered by different vendors
                        through one marketplace.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="benefit-card h-100 p-4 rounded-4">
                    <h3 class="h5 fw-bold">Easy Discovery</h3>

                    <p class="text-muted mb-0">
                        Browse categories to find products that
                        interest you.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="benefit-card h-100 p-4 rounded-4">
                    <h3 class="h5 fw-bold">One Marketplace</h3>

                    <p class="text-muted mb-0">
                        Discover products from different sellers
                        in one place.
                    </p>
                </div>
            </div>

        </div>

    </section>


    <!-- Categories Section -->
    <section id="categories" class="mb-5">

        <div class="d-flex justify-content-between
            align-items-center flex-wrap gap-3 mb-4">

            <div>
                <h2 class="fw-bold mb-1">Shop by Category</h2>

                <p class="text-muted mb-0">
                    Explore our available categories.
                </p>
            </div>

            <a asp-controller="Categories"
               asp-action="Index"
               class="btn btn-outline-primary">
                View All Categories
            </a>

        </div>


        @if (Model.Categories.Count == 0)
        {
            <div class="alert alert-info" role="status">
                No categories are available right now.
                Please check back later.
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-sm-2
                row-cols-lg-3 g-3">

                @foreach (var category in Model.Categories)
                {
                    <div class="col">

                        <a class="category-card d-block h-100
                            text-decoration-none rounded-4 p-4"
                           asp-controller="Products"
                           asp-action="Index"
                           asp-route-category="@category.Slug">

                            <span class="category-icon"
                                  aria-hidden="true">
                                ◈
                            </span>

                            <h3 class="h5 fw-bold mt-3 mb-2">
                                @category.Name
                            </h3>

                            <span class="text-primary">
                                Explore category →
                            </span>

                        </a>

                    </div>
                }

            </div>
        }

    </section>


    <!-- Vendor Section -->
    <section class="vendor-cta rounded-4 p-4 p-md-5">

        <div class="row align-items-center g-3">

            <div class="col-lg-8">

                <h2 class="fw-bold">
                    Ready to grow your business?
                </h2>

                <p class="mb-0">
                    Join MarketHub and take the first step toward
                    selling your products in our marketplace.
                </p>

            </div>

            <div class="col-lg-4 text-lg-end">

                <a asp-controller="VendorApplication"
                   asp-action="Create"
                   class="btn btn-primary btn-lg">
                    Become a Vendor
                </a>

            </div>

        </div>

    </section>

</div>