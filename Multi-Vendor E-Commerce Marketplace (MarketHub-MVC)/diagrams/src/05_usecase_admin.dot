digraph G {
rankdir=LR; fontname="DejaVu Sans"; labelloc=t; fontsize=20;
label="Super Admin Use Case Diagram";
node [fontname="DejaVu Sans", fontsize=11]; edge [fontname="DejaVu Sans", fontsize=9];
Admin [shape=box, style="filled,rounded", fillcolor="#FFF3CD", label="«actor»\nSuper Admin", width=1.4];
subgraph cluster_sys { label="MarketHub-MVC"; style="rounded"; color="#444444"; fontsize=14;
UC23 [shape=ellipse, style=filled, fillcolor="#E3F2FD", label="UC-23 Review Vendor Applications"];
UC24 [shape=ellipse, style=filled, fillcolor="#E3F2FD", label="UC-24 Suspend / Reinstate Vendor"];
UC25 [shape=ellipse, style=filled, fillcolor="#E3F2FD", label="UC-25 Manage Categories"];
UC26 [shape=ellipse, style=filled, fillcolor="#E3F2FD", label="UC-26 Configure Commission Rate"];
UC27 [shape=ellipse, style=filled, fillcolor="#E3F2FD", label="UC-27 Monitor All Orders"];
UC28 [shape=ellipse, style=filled, fillcolor="#E3F2FD", label="UC-28 View Platform Reports"];
UC29 [shape=ellipse, style=filled, fillcolor="#E3F2FD", label="UC-29 Moderate Products"];
}
Admin -> UC23 [arrowhead=none];
Admin -> UC24 [arrowhead=none];
Admin -> UC25 [arrowhead=none];
Admin -> UC26 [arrowhead=none];
Admin -> UC27 [arrowhead=none];
Admin -> UC28 [arrowhead=none];
Admin -> UC29 [arrowhead=none];
UC23 -> UC24 [style=dashed,label="«related»"];

}