sequenceDiagram
  autonumber
  participant ST as Stripe
  participant WC as WebhookController
  participant WS as StripeWebhookService
  participant DB as SQL Server
  participant CM as CommissionService
  ST->>WC: POST /stripe/webhook (raw JSON + Stripe-Signature header)
  WC->>WS: HandleAsync(rawBody, signatureHeader)
  WS->>WS: Verify signature with webhook secret (EventUtility.ConstructEvent)
  alt signature invalid
    WS-->>WC: SignatureVerificationException
    WC-->>ST: 400 Bad Request
  else signature valid
    WS->>DB: BEGIN TX, INSERT StripeWebhookEvent (StripeEventId UNIQUE)
    alt duplicate event id
      DB-->>WS: Unique violation
      WC-->>ST: 200 OK (no changes)
    else new event
      alt checkout.session.completed paid or async_payment_succeeded
        WS->>DB: Load Payment by SessionId + Order (skip if Order already Paid)
        WS->>DB: Payment Succeeded, Order Paid, PaidAt = now
        WS->>CM: CreateForOrderAsync(orderId)
        CM->>DB: Insert CommissionRecord per OrderItem (rate snapshot)
      else checkout.session.expired or async_payment_failed
        WS->>DB: Payment Expired or Failed, Order Cancelled, release reserved stock
      end
      WS->>DB: COMMIT
      WC-->>ST: 200 OK
    end
  end
