digraph G {
rankdir=LR; fontname="DejaVu Sans"; labelloc=t; fontsize=20;
label="Vendor Use Case Diagram (Approved Vendor)";
node [fontname="DejaVu Sans", fontsize=11]; edge [fontname="DejaVu Sans", fontsize=9];
Vendor [shape=box, style="filled,rounded", fillcolor="#FFF3CD", label="«actor»\nVendor", width=1.4];
subgraph cluster_sys { label="MarketHub-MVC"; style="rounded"; color="#444444"; fontsize=14;
UC14 [shape=ellipse, style=filled, fillcolor="#E3F2FD", label="UC-14 Manage Store Profile"];
UC15 [shape=ellipse, style=filled, fillcolor="#E3F2FD", label="UC-15 Manage Products (CRUD)"];
UC16 [shape=ellipse, style=filled, fillcolor="#E3F2FD", label="UC-16 Manage Product Images"];
UC17 [shape=ellipse, style=filled, fillcolor="#E3F2FD", label="UC-17 Manage Inventory"];
UC18 [shape=ellipse, style=filled, fillcolor="#E3F2FD", label="UC-18 View My Order Items"];
UC19 [shape=ellipse, style=filled, fillcolor="#E3F2FD", label="UC-19 Update Fulfillment Status"];
UC20 [shape=ellipse, style=filled, fillcolor="#E3F2FD", label="UC-20 View Sales Summary"];
UC21 [shape=ellipse, style=filled, fillcolor="#E3F2FD", label="UC-21 View Commission Summary"];
UC22 [shape=ellipse, style=filled, fillcolor="#E3F2FD", label="UC-22 Vendor Dashboard"];
}
Vendor -> UC14 [arrowhead=none];
Vendor -> UC15 [arrowhead=none];
Vendor -> UC16 [arrowhead=none];
Vendor -> UC17 [arrowhead=none];
Vendor -> UC18 [arrowhead=none];
Vendor -> UC19 [arrowhead=none];
Vendor -> UC20 [arrowhead=none];
Vendor -> UC21 [arrowhead=none];
Vendor -> UC22 [arrowhead=none];
UC18 -> UC19 [style=dashed,label="«extend»", dir=back];
UC15 -> UC16 [style=dashed,label="«include»"];
UC15 -> UC17 [style=dashed,label="«include stock»"];

}