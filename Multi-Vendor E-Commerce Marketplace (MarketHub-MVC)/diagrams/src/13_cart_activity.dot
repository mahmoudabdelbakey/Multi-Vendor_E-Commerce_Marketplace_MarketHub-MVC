digraph G {
layout=neato; splines=true; overlap=true;
labelloc=t; fontsize=22; fontname="DejaVu Sans"; label="Shopping Cart - Activity Diagram";
node [fontname="DejaVu Sans", fontsize=13, style="filled,rounded", shape=box, margin="0.12,0.08"];
edge [fontname="DejaVu Sans", fontsize=11, arrowsize=0.8];
s [label="Customer clicks\nAdd to Cart", shape=ellipse, style=filled, fillcolor="#C8E6C9", width=1.3, height=0.6, pos="0.00,0.00!"];
d1 [label="Logged in?", shape=diamond, style=filled, fillcolor="#E3F2FD", width=2.5, height=1.25, fontsize=12, pos="3.30,0.00!"];
ld [label="CartService loads Product\nfrom DB (price + stock)", shape=box, style="filled,rounded", fillcolor="#E3F2FD", width=2.4, height=0.9, pos="6.60,0.00!"];
d2 [label="Active product,\nvendor Approved?", shape=diamond, style=filled, fillcolor="#E3F2FD", width=2.5, height=1.25, fontsize=12, pos="9.90,0.00!"];
d3 [label="Quantity valid and\nwithin Stock?", shape=diamond, style=filled, fillcolor="#E3F2FD", width=2.5, height=1.25, fontsize=12, pos="13.20,0.00!"];
lg [label="Redirect to Login,\nthen return", shape=box, style="filled,rounded", fillcolor="#FDE0DC", width=2.4, height=0.9, pos="3.30,2.04!"];
e1 [label="Show: product\nunavailable", shape=box, style="filled,rounded", fillcolor="#FDE0DC", width=2.4, height=0.9, pos="9.90,2.04!"];
e2 [label="Show: not enough\nstock", shape=box, style="filled,rounded", fillcolor="#FDE0DC", width=2.4, height=0.9, pos="13.20,2.04!"];
up [label="Insert or update CartItem\n(unique CustomerId+ProductId)", shape=box, style="filled,rounded", fillcolor="#E3F2FD", width=2.4, height=0.9, pos="13.20,-2.04!"];
vw [label="Cart page recalculates\ntotals from DB prices", shape=box, style="filled,rounded", fillcolor="#E3F2FD", width=2.4, height=0.9, pos="9.90,-2.04!"];
d4 [label="Customer\naction?", shape=diamond, style=filled, fillcolor="#FFF3CD", width=2.5, height=1.25, fontsize=12, pos="6.60,-2.04!"];
rm [label="Delete CartItem", shape=box, style="filled,rounded", fillcolor="#E3F2FD", width=2.4, height=0.9, pos="6.60,-4.25!"];
c [label="Go to Checkout", shape=ellipse, style=filled, fillcolor="#E0E0E0", width=1.3, height=0.6, pos="3.30,-2.04!"];
s->d1
d1->ld [label="Yes"]
d1->lg [label="No"]
lg->ld [constraint=false]
ld->d2
d2->d3 [label="Yes"]
d2->e1 [label="No"]
d3->up [label="Yes"]
d3->e2 [label="No"]
up->vw
vw->d4
d4->c [label="Checkout"]
d4->rm [label="Remove"]
rm->vw [constraint=false]
d4->d3 [label="Update qty", constraint=false]
legend [shape=plaintext, style="", fontsize=12, label="Legend:  yellow = Customer   blue = System   red = error path", pos="2.00,3.40!"];
}