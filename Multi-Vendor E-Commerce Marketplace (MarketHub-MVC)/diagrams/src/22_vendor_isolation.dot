digraph G {
layout=neato; splines=true; overlap=true;
labelloc=t; fontsize=22; fontname="DejaVu Sans"; label="Vendor Isolation - Authorization Flow";
node [fontname="DejaVu Sans", fontsize=13, style="filled,rounded", shape=box, margin="0.12,0.08"];
edge [fontname="DejaVu Sans", fontsize=11, arrowsize=0.8];
r [label="POST /Vendor/Products/Edit/17", shape=ellipse, style=filled, fillcolor="#C8E6C9", width=1.3, height=0.6, pos="0.00,0.00!"];
a [label="Authenticated?", shape=diamond, style=filled, fillcolor="#E3F2FD", width=2.5, height=1.25, fontsize=12, pos="3.30,0.00!"];
p [label="Policy ApprovedVendor:\nrole Vendor AND\nStatus = Approved?", shape=diamond, style=filled, fillcolor="#E3F2FD", width=2.5, height=1.25, fontsize=12, pos="6.60,0.00!"];
v [label="ICurrentVendorService\nresolves VendorProfileId", shape=box, style="filled,rounded", fillcolor="#E3F2FD", width=2.4, height=0.9, pos="9.90,0.00!"];
q [label="Query Products WHERE Id = 17\nAND VendorProfileId = currentVendorId", shape=box, style="filled,rounded", fillcolor="#E3F2FD", width=2.4, height=0.9, pos="9.90,-2.21!"];
f [label="Row found?", shape=diamond, style=filled, fillcolor="#E3F2FD", width=2.5, height=1.25, fontsize=12, pos="6.60,-2.21!"];
ok [label="Bind ONLY allowed\nViewModel fields, save", shape=ellipse, style=filled, fillcolor="#E0E0E0", width=1.3, height=0.6, pos="3.30,-2.21!"];
r1 [label="Challenge:\nredirect to Login", shape=box, style="filled,rounded", fillcolor="#FDE0DC", width=2.4, height=0.9, pos="3.30,2.04!"];
r2 [label="403 Forbidden", shape=box, style="filled,rounded", fillcolor="#FDE0DC", width=2.4, height=0.9, pos="6.60,2.04!"];
r3 [label="404 Not Found\n(same for missing and\nother vendor product)", shape=box, style="filled,rounded", fillcolor="#FDE0DC", width=2.4, height=0.9, pos="6.60,-4.59!"];
r->a
a->p [label="Yes"]
a->r1 [label="No"]
p->v [label="Yes"]
p->r2 [label="No"]
v->q
q->f
f->ok [label="Yes"]
f->r3 [label="No"]
}