digraph G {
layout=neato; splines=true; overlap=true;
labelloc=t; fontsize=22; fontname="DejaVu Sans"; label="Checkout - Activity Diagram";
node [fontname="DejaVu Sans", fontsize=13, style="filled,rounded", shape=box, margin="0.12,0.08"];
edge [fontname="DejaVu Sans", fontsize=11, arrowsize=0.8];
s [label="Customer clicks\nCheckout", shape=ellipse, style=filled, fillcolor="#C8E6C9", width=1.3, height=0.6, pos="0.00,0.00!"];
d1 [label="Cart not\nempty?", shape=diamond, style=filled, fillcolor="#E3F2FD", width=2.5, height=1.25, fontsize=12, pos="3.30,0.00!"];
ad [label="Enter shipping\ndetails", shape=box, style="filled,rounded", fillcolor="#FFF3CD", width=2.4, height=0.9, pos="6.60,0.00!"];
po [label="POST /Checkout/Pay\n(AntiForgery token)", shape=box, style="filled,rounded", fillcolor="#FFF3CD", width=2.4, height=0.9, pos="9.90,0.00!"];
d2 [label="Reload products from DB:\nall valid + in stock?", shape=diamond, style=filled, fillcolor="#E3F2FD", width=2.5, height=1.25, fontsize=12, pos="13.20,0.00!"];
e0 [label="Redirect to Cart", shape=box, style="filled,rounded", fillcolor="#FDE0DC", width=2.4, height=0.9, pos="3.30,2.04!"];
fx [label="Show problems,\nupdate cart", shape=box, style="filled,rounded", fillcolor="#FDE0DC", width=2.4, height=0.9, pos="13.20,2.04!"];
tx [label="BEGIN TRANSACTION:\ncreate Order + OrderItems,\nreserve stock,\ncreate Payment Pending", shape=box, style="filled,rounded", fillcolor="#E3F2FD", width=2.4, height=0.9, pos="13.20,-2.21!"];
d3 [label="Stock reserved\nfor all items?", shape=diamond, style=filled, fillcolor="#E3F2FD", width=2.5, height=1.25, fontsize=12, pos="9.90,-2.21!"];
rb [label="ROLLBACK, show\ninsufficient stock", shape=box, style="filled,rounded", fillcolor="#FDE0DC", width=2.4, height=0.9, pos="9.90,-4.42!"];
cm [label="COMMIT, then create\nStripe Checkout Session\n(metadata OrderId, expires_at)", shape=box, style="filled,rounded", fillcolor="#E3F2FD", width=2.4, height=0.9, pos="6.60,-2.21!"];
e [label="Redirect to Stripe-\nhosted payment page", shape=ellipse, style=filled, fillcolor="#E0E0E0", width=1.3, height=0.6, pos="3.30,-2.21!"];
s->d1
d1->ad [label="Yes"]
d1->e0 [label="No"]
ad->po
po->d2
d2->tx [label="Yes"]
d2->fx [label="No"]
tx->d3
d3->cm [label="Yes"]
d3->rb [label="No"]
cm->e
legend [shape=plaintext, style="", fontsize=12, label="Legend:  yellow = Customer   blue = System   red = error path", pos="2.00,3.50!"];
}