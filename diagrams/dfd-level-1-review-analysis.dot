digraph G { rankdir=LR; graph [bgcolor="white",pad="0.3"]; node [fontname="Arial",fontsize=9];
P1[shape=circle,label="1. Validate Review",style="filled",fillcolor="#eef6f6"]; P2[shape=circle,label="2. Store Review",style="filled",fillcolor="#eef6f6"]; P3[shape=circle,label="3. Predict Sentiment",style="filled",fillcolor="#eef6f6"]; P4[shape=circle,label="4. Store Prediction",style="filled",fillcolor="#eef6f6"]; P5[shape=circle,label="5. Return Result",style="filled",fillcolor="#eef6f6"]; D1[shape=cylinder,label="Reviews",style="filled",fillcolor="#f5f1e8"]; D2[shape=cylinder,label="Predictions",style="filled",fillcolor="#f5f1e8"]; ML[shape=box,label="ML.NET Model"];
P1->P2[label="valid request"]; P1->P3[label="eligible text"]; P2->D1[label="review"]; D1->P4[label="review id"]; P3->ML[label="prepared input"]; ML->P4[label="prediction"]; P4->D2[label="prediction"]; D2->P5[label="stored result"]; P5->P1[label="response path",style=dashed];}