digraph G { rankdir=TB; graph [bgcolor="white",pad="0.3"]; node [shape=box,style="rounded,filled",fontname="Arial",fillcolor="#eef6f6",color="#3b6666"]; edge [fontname="Arial",color="#555555"];
Start[shape=circle,label="Start",width=.3]; Receive[label="Receive review request"]; Validate[label="Validate payload"]; Valid[shape=diamond,label="Valid?"]; Product[shape=diamond,label="Product context valid?"]; Save[label="Persist review"]; Predict[label="Call ML.NET prediction service"]; ModelOK[shape=diamond,label="Prediction successful?"]; SavePred[label="Persist prediction"]; Response[label="Return result"]; Error[label="Return controlled error + log"]; End[shape=doublecircle,label="End",width=.35];
Start->Receive->Validate->Valid; Valid->Product[label="Yes"]; Valid->Error[label="No"]; Product->Save[label="Yes / not required"]; Product->Error[label="No"]; Save->Predict->ModelOK; ModelOK->SavePred[label="Yes"]; ModelOK->Error[label="No"]; SavePred->Response->End; Error->End;}