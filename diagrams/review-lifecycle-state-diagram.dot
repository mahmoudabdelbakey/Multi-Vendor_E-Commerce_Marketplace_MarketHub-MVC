digraph G { rankdir=LR; graph [bgcolor="white",pad="0.3"]; node [shape=box,style="rounded,filled",fontname="Arial",fillcolor="#eef6f6",color="#3b6666"];
Submitted->Validated[label="validation passed"]; Submitted->Rejected[label="validation failed"]; Validated->Processing[label="eligible"]; Processing->Analyzed[label="prediction success"]; Processing->ProcessingFailed[label="prediction failure"]; Analyzed->Visible[label="stored successfully"]; ProcessingFailed->Retryable[label="if policy allows retry"]; Rejected->Submitted[label="corrected request",style=dashed]; Retryable->Processing[label="retry",style=dashed];}